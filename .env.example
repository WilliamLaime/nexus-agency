# ============================================================
# Nexus Agency — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ============================================================

# --- Clés API LLM (OBLIGATOIRE) ---
ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=                  # Optionnel
# GEMINI_API_KEY=                  # Optionnel

# --- Sécurité (OBLIGATOIRE) ---
# Générer avec : openssl rand -base64 32
NEXUS_MEMORY_ENCRYPTION_KEY=

# Générer avec : openssl rand -hex 32
NEXUS_AGENT_SECRET=

# Mode bancaire — active les politiques PII strictes (CACD2/CA)
NEXUS_BANKING_MODE=false

# Niveau de confiance par défaut pour les agents
NEXUS_TRUST_LEVEL=VERIFIED

# Liste des agents de confiance maximale (TRUSTED), séparés par virgule
NEXUS_TRUSTED_AGENTS=security-architect,security-auditor,compliance-officer,devops-engineer,sre

# --- Politique PII ---
# BLOCK : rejette l'input/output
# REDACT : remplace par [REDACTED:TYPE]
# HASH : hache SHA-256 (déterministe, réversible avec clé)
# PASS : laisse passer, log uniquement
NEXUS_PII_POLICY=REDACT

# --- Audit & Rétention ---
NEXUS_AUDIT_LOG_RETENTION_DAYS=90
NEXUS_LOG_LEVEL=info

# --- Mémoire ---
NEXUS_MEMORY_BACKEND=hybrid
NEXUS_ACTIVE_NAMESPACES=default-strategy,default-design,default-dev

# --- Rotation des clés (format YYYY-MM-DD) ---
# Mettre à jour à chaque rotation pour le reminder worker
# NEXUS_ANTHROPIC_KEY_ROTATED_AT=2026-05-05
# NEXUS_ENC_KEY_ROTATED_AT=2026-05-05
# NEXUS_AGENT_SECRET_ROTATED_AT=2026-05-05
NEXUS_KEY_ROTATION_DAYS=30

# --- Configuration ---
NEXUS_MAX_AGENTS=8

# --- CVE Monitor ---
# Désactive la vérification CVE-2026-21852 (déconseillé)
# NEXUS_SKIP_CVE2026_CHECK=false
